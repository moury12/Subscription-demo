default_platform(:ios)

platform :ios do
  desc "Push a new Release Build to TestFlight"
  lane :beta do |options|
    # 1. Authenticate with App Store Connect API Key
    # Using the local .p8 file and credentials provided
    api_key = app_store_connect_api_key(
      key_id: "3BB423WJHG",
      issuer_id: "39b8ddc7-5804-4b8f-87af-8c99bf6f8656",
      key_filepath: File.expand_path("../../AuthKey_3BB423WJHG.p8", __dir__)
    )

    # Get version from options or parse from pubspec.yaml
    version = options[:version]
    if !version
      begin
        pubspec_content = File.read(File.expand_path("../../pubspec.yaml", __dir__))
        version = pubspec_content.match(/^version:\s*([^\s+]+)/)[1]
      rescue => e
        UI.important("Could not parse version from pubspec.yaml: #{e.message}. Defaulting to 1.0.0")
        version = "1.0.0"
      end
    end

    # Get build number from options or fetch from TestFlight
    new_build_number = options[:build_number]
    if !new_build_number
      begin
        latest_build = latest_testflight_build_number(
          api_key: api_key,
          app_identifier: "com.asha.gocal.ios",
          version: version
        )
        new_build_number = latest_build + 1
      rescue => e
        UI.important("Could not fetch latest build number from TestFlight for version #{version}: #{e.message}. Defaulting to 1.")
        new_build_number = 1
      end
    end

    # Set version and build number in Xcode project (flutter build will use this)
    increment_version_number(
      version_number: version,
      xcodeproj: "Runner.xcodeproj"
    )
    increment_build_number(
      build_number: new_build_number,
      xcodeproj: "Runner.xcodeproj"
    )
    UI.success("Set version to #{version} and build number to #{new_build_number}")

    # 3. Code Signing via match
    # api_key parameter is passed to match for App Store Connect API communication
    match(
      type: "appstore",
      readonly: false, # Set to false if you want match to generate certificates/profiles if they don't exist
      api_key: api_key
    )

    # 4. Build the Flutter App (No codesign phase in Flutter build)
    # We run the build from the project root directory
    cocoapods(use_bundle_exec: false)
    Dir.chdir("../..") do
      sh("flutter", "build", "ios", "--release", "--no-codesign")
    end

    # 5. Build and Package IPA using gym (fastlane's build_app)
    # This signs the app using the provision profiles fetched by match
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "gocal_ai.ipa"
    )

    # 6. Upload the final IPA to TestFlight using the API Key
    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/ios/ipa/gocal_ai.ipa",
      skip_waiting_for_build_processing: true # Set to false if you want fastlane to wait until processing is done
    )
  end
end
